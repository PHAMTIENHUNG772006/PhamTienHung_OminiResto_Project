		{
			"name": "10. Validation Test Scenarios (Negative Cases)",
			"description": "Các kịch bản kiểm tra lỗi xác thực dữ liệu đầu vào (HTTP 400 Bad Request) để kiểm tra cấu trúc lỗi trả về Frontend dạng: { success: false, message: '...', data: { field: 'lỗi' } }",
			"item": [
				{
					"name": "10.1 Lỗi Chi Nhánh: Thiếu trường bắt buộc & Số điện thoại sai",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 400 Bad Request\", function () {",
									"    pm.response.to.have.status(400);",
									"});",
									"pm.test(\"Response contains validation errors map in data\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.eql(false);",
									"    pm.expect(jsonData.data).to.be.an(\"object\");",
									"    pm.expect(jsonData.data).to.have.property(\"name\");",
									"    pm.expect(jsonData.data).to.have.property(\"phone\");",
									"    console.log(\"Field errors returned to FE:\", jsonData.data);",
									"});"
